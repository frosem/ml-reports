{
  "name": "ml-allure-reports",
  "config": {
    "shards": 4,
    "workers": 2
  },
  "engines": {
    "node": "20"
  },
  "scripts": {
    "allure": "npx tsx scripts/allure-cli.ts",
    "allure:clean": "npm run allure -- clean",
    "allure:clean:old": "npm run allure -- clean:old",
    "allure:generate": "npm run allure -- generate",
    "allure:open": "npm run allure -- open",
    "cypress:install": "cypress install",
    "cypress:verify": "cypress verify",
    "cypress:test": "cypress run --browser chrome --spec \"cypress/e2e/saucedemo/**/*.specs.ts\" --env allure=true",
    "cypress:allure": "npm run allure:clean:old -- cypress && npm run cypress:test || true && npm run allure:generate -- cypress && npm run allure:open -- cypress",
    "jira:create-bugs": "npx tsx scripts/create-jira-bugs.ts",
    "jira:dry-run": "DRY_RUN=true npx tsx scripts/create-jira-bugs.ts",
    "playwright:install": "npx playwright install --with-deps chromium",
    "playwright:verify": "npx playwright test --list",
    "playwright:test": "npx playwright test --project=chromium",
    "playwright:allure": "npm run allure:clean:old -- playwright && npm run playwright:test || true && npm run allure:generate -- playwright && npm run allure:open -- playwright",
    "prettier:fix": "prettier --write",
    "test:ci": "npm run allure:clean && npm run cypress:test || true && npm run jira:create-bugs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cypress/grep": "^5.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.36.0",
    "allure-cypress": "^3.4.3",
    "allure-js-commons": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "cypress": "^14.5.4",
    "cypress-split": "^1.24.25",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
