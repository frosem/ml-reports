{
  "name": "ml-cypress-testing",
  "version": "1.0.0",
  "description": "Cypress automation testing for SauceDemo with TypeScript and Allure reports",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test": "cypress run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.40.2",
    "allure-commandline": "^2.25.0",
    "cypress": "^13.6.2",
    "typescript": "^5.3.3"
  }
}
