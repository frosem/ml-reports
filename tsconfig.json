{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "lib": ["DOM", "ES5", "ES6"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@cypress-page-actions/*": ["cypress/page-actions/*"],
      "@cypress-support/*": ["cypress/support/*"],
      "@fixtures/*": ["shared/fixtures/*"],
      "@jira/*": ["jira/*"],
      "@page-objects/*": ["shared/page-objects/*"],
      "@playwright-core/*": ["playwright/core/*"],
      "@playwright-page-actions/*": ["playwright/page-actions/*"],
      "@playwright-support/*": ["playwright/support/*"],
      "@shared/*": ["shared/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES6",
    "typeRoots": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts"]
}
