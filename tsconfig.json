{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "lib": ["DOM", "ES5", "ES6"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "paths": {
        "allure-cypress/reporter": ["./node_modules/allure-cypress/dist/reporter"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES6",
    "typeRoots": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts"]
}
